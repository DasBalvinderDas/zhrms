# --- LLM backing the ADK agent (Vertex AI, using your GCP project) ---
# Cloud Shell already has your user credentials; just make sure Application
# Default Credentials are set (see README) and the Vertex AI API is enabled
# on this project.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.0-flash

# Only needed if you'd rather use an AI Studio key instead of Vertex AI:
# set GOOGLE_GENAI_USE_VERTEXAI=FALSE and fill this in instead of the three
# GCP vars above.
# GOOGLE_API_KEY=your-gemini-api-key

# --- Zoho MCP server ---
# 1. Go to https://mcp.zoho.com and create a server (or use a pre-configured one).
# 2. Add Tools -> select the "People" (HR) and "Payroll" products, and enable
#    the employee/leave/attendance and payslip/payroll-run tools you want to demo.
# 3. Open the server's "Connect" tab and copy the generated MCP URL.
#    It already carries a per-server API key, e.g.:
#    https://mcp.zoho.com/api/mcp/<server-id>?api_key=<generated-key>
ZOHO_MCP_URL=https://mcp.zoho.com/api/mcp/<your-server-id>

# Optional: only set this if your server is configured for header-based auth
# instead of the api_key query param above.
ZOHO_MCP_API_KEY=

# streamable_http (default, recommended) or sse
ZOHO_MCP_TRANSPORT=streamable_http

# Optional: comma-separated allow-list to restrict which Zoho MCP tools the
# agent can see, e.g. "list_employees,get_employee,get_leave_balance".
# Leave empty to expose every tool enabled on the Zoho MCP server.
ZOHO_MCP_TOOL_FILTER=
