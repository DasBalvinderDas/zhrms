# --- LLM backing the ADK agent (Vertex AI, using your GCP project) ---
# Cloud Shell already has your user credentials; just make sure Application
# Default Credentials are set (see README) and the Vertex AI API is enabled
# on this project.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# Only needed if you'd rather use an AI Studio key instead of Vertex AI:
# set GOOGLE_GENAI_USE_VERTEXAI=FALSE and fill this in instead of the three
# GCP vars above.
# GOOGLE_API_KEY=your-gemini-api-key

# --- Zoho MCP server ---
# 1. Go to your Zoho MCP console (e.g. https://mcp.zoho.in or mcp.zoho.com)
#    and create a server (or use a pre-configured one).
# 2. Tools -> Add Tools -> select "Zoho Creator" -> the specific app holding
#    your HR data (e.g. a custom "Human Resource Management" app) -- enable
#    whichever tool group gives generic form/report/record access.
#    (This project originally targeted Zoho People, then Zoho Payroll too,
#    but settled on a single Zoho Creator app for everything -- employees,
#    leave, and compensation -- once it turned out the connected account had
#    no real organization set up in either of those separate products. If
#    yours does, People/Payroll's own tools work the same shape as Creator's
#    here, just with different, HR-specific tool names.)
#    Zoho MCP consoles have a per-server tool-count cap (this repo was built
#    against a 300-tool cap) -- Creator's generic tool group alone is a
#    small fraction of that.
# 3. Connection -> switch authorization mode to "Authorize via Connection"
#    (NOT "Authorize on Demand" -- the latter requires each MCP client to do
#    its own interactive OAuth login, which doesn't work well from a headless
#    shell or a deployed agent). "Authorize via Connection" pre-authorizes all
#    tools once, in the console, and bakes that into the server URL itself.
# 4. Open the "Connect" tab and copy the generated MCP URL.
ZOHO_MCP_URL=https://<your-server>.zohomcp.in/mcp/<token>/message

# Only needed if your server is instead left on header-based/bearer auth.
ZOHO_MCP_API_KEY=

# streamable_http (default, recommended) or sse
ZOHO_MCP_TRANSPORT=streamable_http

# Comma-separated allow-list restricting which Zoho MCP tools the agent can
# see. Matches the 4 demo use cases (employee lookup, workforce insights,
# leave, compensation) against the tools enabled in Step 2 above. Leave
# empty to expose every tool enabled on the Zoho MCP server instead.
#
# Note: scripts/seed_demo_data.py uses a separate, wider tool set (adds
# addRecords, which writes data) -- it does not read this variable, so
# seeding stays possible even with a narrow filter here.
ZOHO_MCP_TOOL_FILTER=ZohoCreator_getApplications,ZohoCreator_getForms,ZohoCreator_getReports,ZohoCreator_getFormMetadata,ZohoCreator_getReportMetadata,ZohoCreator_getCreatorRecords,ZohoCreator_getRecordByID,ZohoCreator_addRecords
