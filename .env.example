# --- LLM backing the ADK agent (Vertex AI, using your GCP project) ---
# Cloud Shell already has your user credentials; just make sure Application
# Default Credentials are set (see README) and the Vertex AI API is enabled
# on this project.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# Only needed if you'd rather use an AI Studio key instead of Vertex AI:
# set GOOGLE_GENAI_USE_VERTEXAI=FALSE and fill this in instead of the three
# GCP vars above.
# GOOGLE_API_KEY=your-gemini-api-key

# --- Zoho MCP server ---
# 1. Go to your Zoho MCP console (e.g. https://mcp.zoho.in or mcp.zoho.com)
#    and create a server (or use a pre-configured one).
# 2. Tools -> Add Tools -> select "Zoho People" and "Zoho Payroll", and enable
#    the Leave, Reports/Insights, and Pay Run tool groups.
# 3. Connection -> switch authorization mode to "Authorize via Connection"
#    (NOT "Authorize on Demand" -- the latter requires each MCP client to do
#    its own interactive OAuth login, which doesn't work well from a headless
#    shell or a deployed agent). "Authorize via Connection" pre-authorizes all
#    tools once, in the console, and bakes that into the server URL itself.
# 4. Open the "Connect" tab and copy the generated MCP URL.
ZOHO_MCP_URL=https://<your-server>.zohomcp.in/mcp/<token>/message

# Only needed if your server is instead left on header-based/bearer auth.
ZOHO_MCP_API_KEY=

# streamable_http (default, recommended) or sse
ZOHO_MCP_TRANSPORT=streamable_http

# Comma-separated allow-list restricting which Zoho MCP tools the agent can
# see. Matches the 3 demo use cases (workforce insights, leave, payroll pay
# runs) against the tools enabled in Step 2 above. Leave empty to expose
# every tool enabled on the Zoho MCP server instead.
ZOHO_MCP_TOOL_FILTER=ZohoPeople_employeeInsights,ZohoPeople_fetchLeaveTypes,ZohoPeople_getLeaveBalance,ZohoPeople_fetchLeaveBasicInfo,ZohoPeople_applyLeave,ZohoPayroll_list_payruns,ZohoPayroll_get_payrun,ZohoPayroll_list_payrun_employees,ZohoPayroll_get_payrun_employee
